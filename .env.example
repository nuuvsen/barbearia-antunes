# Copie este arquivo para ".env" e preencha com as chaves reais.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

# Chave da API do ImgBB, usada para upload de fotos de produtos em AdminProdutos.jsx
# Gere a sua em https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# Endereço do servidor do bot do WhatsApp (projeto separado, pasta Bot-barbearia).
# Teste local com Docker Desktop, mapeando a porta 3001 do container para fora:
#   VITE_BOT_URL=http://localhost:3001
# Quando o bot estiver rodando no VPS, troque pelo IP ou domínio dele, com HTTPS se tiver:
#   VITE_BOT_URL=http://SEU_IP_OU_DOMINIO:3001
# Se não definir, o app usa http://localhost:3001 como padrão.
VITE_BOT_URL=http://localhost:3001

# Chave pública (VAPID) do Firebase Cloud Messaging, usada pra ativar notificações push
# no app do cliente e do barbeiro. Gere em:
#   Console do Firebase > Configurações do Projeto > Cloud Messaging > Certificados push da Web > Gerar par de chaves
# Sem essa chave, o botão "Ativar Notificações" fica desativado (mas o resto do site funciona normal).
VITE_FIREBASE_VAPID_KEY=
